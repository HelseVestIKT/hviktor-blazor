@using Hviktor.Abstractions.Enums.Attributes
@using Hviktor.Components.Tag

@if (required)
{
    <Tag color="@Color.Warning" variant="@Variant.Default" @attributes="@(ComputeAttributes())">
        @(mode is "all" ? Localizer.GetValue("Hviktor.Components.RequiredTag.Required.All") : Localizer.GetValue("Hviktor.Components.RequiredTag.Required"))
    </Tag>
    return;
}

<Tag color="@Color.Info" variant="@Variant.Default" @attributes="@(ComputeAttributes())">
    @(mode is "all" ? Localizer.GetValue("Hviktor.Components.RequiredTag.Optional.All") : Localizer.GetValue("Hviktor.Components.RequiredTag.Optional"))
</Tag>
