{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "pnpm": ">=11.0.0",
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "prepare": "husky",
    "build:dev": "pnpm -r build:dev",
    "build:prod": "pnpm -r build:prod",
    "pack:dev": "node tools/pack-dev.mjs",
    "test-pack:dev": "pnpm -r test-pack",
    "format": "prettier --write \"**/*.{js,ts,mjs,scss,css,html,json,md}\"",
    "generate:metadata": "pnpm -r generate:metadata",
    "generate:html": "pnpm -r generate:html"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "autoprefixer": "10.6.1",
    "cssnano": "9.9.0",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "immutable": "5.1.9",
    "lint-staged": "17.6.0",
    "postcss": "8.5.31",
    "postcss-cli": "12.0.0",
    "postcss-import": "17.0.1",
    "postcss-mixins": "12.1.2",
    "postcss-nested": "9.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svgo": "4.1.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs}": "prettier --check",
    "*.{css,scss,html}": "prettier --check",
    "*.{json,md}": "prettier --check"
  }
}
