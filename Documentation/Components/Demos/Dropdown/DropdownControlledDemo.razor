@using Hviktor.Components.Dropdown
@using Hviktor.Components.Icon
@using Hviktor.Icons.Types

@code {
    private bool open;

    private void ToggleOpen()
    {
        if (open)
        {
            SetClosed();
            return;
        }

        SetOpen();
    }

    private void SetOpen() => open = true;
    private void SetClosed() => open = false;
}

<Dropdown.TriggerContext>
    <Dropdown.Trigger @onclick="@ToggleOpen">
        Dropdown
        <Icon Definition="@(open ? IconSet.ChevronDown : IconSet.ChevronUp)" aria-hidden="true"/>
    </Dropdown.Trigger>
    <Dropdown @open="@open" onClose="@(() => SetClosed())">
        <Dropdown.List>
            <Dropdown.Item>
                <Dropdown.Button @onclick="@SetClosed">
                    Click me to close
                </Dropdown.Button>
            </Dropdown.Item>
            <Dropdown.Item>
                <Dropdown.Button @onclick="@SetClosed">
                    I close too
                </Dropdown.Button>
            </Dropdown.Item>
        </Dropdown.List>
    </Dropdown>
</Dropdown.TriggerContext>
